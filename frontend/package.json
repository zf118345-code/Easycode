{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:player": "vite build --config vite.player.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{vue,js,ts}\" --fix",
    "lint:check": "eslint \"src/**/*.{vue,js,ts}\"",
    "ui:contract": "node scripts/check-vnext-ui-contract.mjs",
    "format": "prettier --write \"src/**/*.{vue,js,ts,css,json}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.0",
    "element-plus": "^2.8.0",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "splitpanes": "^4.1.2",
    "vue": "^3.4.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.0.0",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
