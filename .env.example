# ====== Easycode 环境变量配置示例 ======
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交到仓库）

# 运行环境: dev | prod
# - dev : 允许使用兜底 Salt，CORS 默认仅允许本机开发端口
# - prod: 必须显式注入 Salt，CORS 仅允许本机运行入口或显式配置的来源
APP_ENV=dev

# 资产加密 PBKDF2 Salt（生产环境必填，建议 16 字节以上随机字符串）
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(32))"
EASYCODE_MASTER_SALT=

# 允许的 CORS 来源（逗号分隔），未设置时:
# - dev : 允许本机 5173/5174/4173 开发端口及 8000 运行入口
# - prod: 仅允许本机回环 http://127.0.0.1:8000,http://localhost:8000
EASYCODE_CORS_ORIGINS=

# 全局速率限制 (slowapi 格式)，默认 120/minute
EASYCODE_RATE_LIMIT=120/minute

# 仅供开发模式单独预览 Player 使用；必须显式指向一个已构建的 assets.ebp。
# 正式 EXE 固定读取自身 release/assets.ebp，不读取 IDE 最近项目或当前工作目录。
EASYCODE_PLAYER_BUNDLE=

# 局域网协调服务令牌。只有需要跨电脑消息/资源锁时才配置；
# 使用 --host 0.0.0.0 暴露服务时后端会强制要求此项。
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(32))"
EASYCODE_COORDINATOR_TOKEN=

# 共享能力包根目录（可选）。未设置时使用
# %LOCALAPPDATA%\EasyCode\capabilities。项目私有能力仍放在 <project>\capabilities。
EASYCODE_CAPABILITY_HOME=
